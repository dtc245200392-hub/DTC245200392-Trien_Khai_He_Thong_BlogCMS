# Cấu hình Cơ sở dữ liệu MySQL
MYSQL_ROOT_PASSWORD=CmsSecureRootPass2026!
MYSQL_DATABASE=wordpress_cms
MYSQL_USER=cms_user
MYSQL_PASSWORD=CmsSecureUserPass2026!

# Cổng dịch vụ Nginx Reverse Proxy
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Cổng phpMyAdmin trực tiếp (Tùy chọn)
PMA_PORT=8081

# Cổng các dịch vụ Giám sát (Monitoring)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080

# Cổng hệ thống Log tập trung (Loki)
LOKI_PORT=3100

# Tài khoản quản trị Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=AdminGrafana2026!
